# --- DB ---
DATABASE_URL=postgres://orun:orun@localhost:5432/orun
# --- 0G chain (Galileo 16602) ---
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
TREASURY_PRIVATE_KEY=        # wallet team: deploy, mint, storage fee, funder
AGENT_NFT_ADDRESS=           # da Task 9
COACH_REGISTRY_ADDRESS=      # da Task 9
# --- 0G Compute ---
ROUTER_API_URL=https://router-api.0g.ai/v1
ROUTER_API_KEY=              # sk-... da pc.0g.ai
ROUTER_MODEL_PRIMARY=glm-5.2
ROUTER_MODEL_FALLBACK=0gm-1.0-35b-a3b
DIRECT_ENABLED=0             # 1 abilita il path Direct (attestazione TEE per-risposta, paga dalla tesoreria)
DIRECT_PROVIDERS=            # csv indirizzi provider (0G Compute direct), da broker.inference.listService()
INFERENCE_PREFER=            # "direct" per preferire l'attestazione alla qualita del modello; vuoto = router-first
# --- crypto ---
SERVICE_ENC_KEY=             # 32 byte hex: openssl rand -hex 32
# --- Privy ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# --- ENS (su Sepolia: ENS non esiste su 0G) ---
ENS_SEPOLIA_RPC=
ENS_PARENT_NAME=            # es. 0run.eth registrato su Sepolia
ENS_OWNER_PRIVATE_KEY=      # wallet che possiede il nome e crea i subname
ENS_OWNER_ADDRESS=
# --- A2A (comunicazione agente->agente, identità via ENS) ---
A2A_SIGNER_PRIVATE_KEY=     # chiave executor che firma i consulti; il suo address è pubblicato come text record ENS "agent-signer"
A2A_ENDPOINT_OVERRIDE=      # solo dev: es. http://localhost:3000 — rimpiazza l'origin dell'endpoint risolto da ENS
# --- World ID (cloud-verify: nessun WorldIDRouter su 0G) ---
NEXT_PUBLIC_WORLD_APP_ID=    # app_... da developer.world.org (pubblico)
NEXT_PUBLIC_WORLD_ACTION=    # es. claim-run-event
WORLD_RP_ID=                 # rp_...
WORLD_SIGNING_KEY=           # SEGRETO: firma l'rp-context (scaricato come signing-key-*.json)
RUN_EVENTS_ADDRESS=          # RunEvents.sol su Galileo (Piano B, Task 1) — backend = TREASURY_PRIVATE_KEY
# Facoltativa: action World dedicata per il badge coach autodichiarato (Piano
# B, Task 5), cosi' il suo nullifier non condivide lo stesso spazio azione del
# claim eventi — va creata a mano su developer.world.org PRIMA di impostarla
# qui (mai un id inventato). Se vuota, il claim coach riusa
# NEXT_PUBLIC_WORLD_ACTION: la separazione resta solo a livello di signal
# (coach-claim:<wallet> vs eventId:wallet), non di nullifier.
NEXT_PUBLIC_WORLD_COACH_ACTION=
WORLD_CHAIN_RPC=             # RPC di World Chain per AgentBook (default: RPC pubblico Alchemy)
WORLD_AGENTBOOK_ADDRESS=     # indirizzo AgentBook (default: deploy canonico su World Chain mainnet).
                             # Serve se WORLD_CHAIN_RPC punta a una rete diversa: altrimenti si legge
                             # un indirizzo dove non c'è nessun contratto e OGNI wallet risulta "non umano".
REQUIRE_HUMAN_BACKED_MINT=   # "1" richiede che il wallet sia registrato in World AgentBook per mintare
                             # un coach, e registra l'humanId (un umano = un coach, imposto da Postgres).
                             # Qualsiasi altro valore, vuoto compreso, NON applica il vincolo e non salva
                             # l'humanId: la registrazione avviene in World App tramite
                             # `npx @worldcoin/agentkit-cli register <wallet>`, quindi con il vincolo attivo
                             # per default nessun utente riuscirebbe a mintare.
                             # Non salta né può saltare la verifica di una proof World ID (altro meccanismo).

# --- Funzioni nascoste (apps/web/src/lib/features.ts) -----------------------
# Nascoste, non rimosse: codice, contratti e test restano al loro posto, quindi
# riattivarle è solo mettere "1" qui e ricostruire l'immagine. Qualsiasi altro
# valore (vuoto compreso) le tiene spente, e con esse anche le loro API — non
# basta togliere il link: /api/events spende gas della tesoreria.
NEXT_PUBLIC_FEATURE_EVENTS=          # eventi di corsa e claim con World ID (/events)
NEXT_PUBLIC_FEATURE_HUMAN_COACH=     # badge "coach umano" autodichiarato (/api/coach-claims)
